---
import type { ProjectImage } from '../data/portfolio';
interface Props { name: string; images: ProjectImage[]; composition?: string; }
const { name, images, composition = 'layered' } = Astro.props;
const slides: ProjectImage[] = images.length ? images : [{src:null, alt:'', caption:'Screenshot'}];
---
<section class="screenshot-gallery" data-composition={composition} aria-label={`${name} screenshots`}>
  <div class="screenshot-composition">
    <div class="screenshot-window">
      {slides.map((image, i) => (
        <div class="screenshot-slide" hidden={i !== 0} data-caption={image.caption} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
          {image.src ? <button class="screenshot-open" type="button" data-open-index={i} aria-label={`Enlarge ${name}: ${image.caption}`}><img src={image.src} alt={image.alt} loading="lazy" width={image.width ?? 960} height={image.height ?? 640} decoding="async" /></button> : <div class="screenshot-placeholder"><span>{name}</span><span>{image.caption}</span><small>Screenshot coming soon</small></div>}
        </div>
      ))}
    </div>
    <div class="secondary-stage">
    {slides.length > 1 && slides.map((image, i) => image.src && (
      <button class="screenshot-secondary" type="button" data-open-index={i} data-portrait={(image.height ?? 0) > (image.width ?? 0)} hidden={i !== 1} aria-label={`Enlarge ${name}: ${image.caption}`}>
        <img src={image.src} alt={image.alt} width={image.width ?? 960} height={image.height ?? 640} loading="lazy" decoding="async" />
        <span>{image.caption} <span aria-hidden="true">&#8599;</span></span>
      </button>
    ))}
    </div>
  </div>
  <div class="screenshot-toolbar">
    <span class="screenshot-caption" aria-live="polite" aria-atomic="true">1 / {slides.length} {slides[0].caption}</span>
    <div class="screenshot-thumbnails" role="group" aria-label="Choose screenshot">
      {slides.map((image, i) => <button class="screenshot-thumbnail" type="button" data-image-select={i} aria-pressed={i === 0} aria-label={`Show ${name}: ${image.caption}`}>
        {image.src ? <img src={image.src} alt="" loading="lazy" width={image.width ?? 960} height={image.height ?? 640} decoding="async" /> : <span>Image {i + 1}<small>Coming soon</small></span>}
      </button>)}
    </div>
  </div>
  {slides.some(image => image.src) && <dialog class="screenshot-viewer" aria-label={`${name} enlarged screenshots`}>
    <button class="viewer-close" type="button" autofocus>Close &#215;</button>
    <div class="viewer-image"></div>
    <div class="viewer-toolbar">
      <div class="viewer-selectors" role="group" aria-label="Choose enlarged screenshot">
        {slides.map((image, i) => <button type="button" data-viewer-select={i}>{i + 1}. {image.caption}</button>)}
      </div>
      <span class="viewer-caption" aria-live="polite"></span>
    </div>
  </dialog>}
</section>
<script>import '../scripts/carousel.js';</script>
<style>
  :global(#kim-portfolio) .screenshot-gallery {min-width:0}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-composition {position:relative;padding:20px 24px 110px 0;isolation:isolate}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-window {position:relative;aspect-ratio:16/10;border:1px solid var(--line);background:var(--surface);transform:rotate(-1deg);box-shadow:0 18px 32px rgb(0 0 0 / .12);overflow:hidden}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-open {padding:0;border:0;display:block;width:100%;height:100%;background:transparent}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-window img {width:100%;height:100%;object-fit:contain;filter:none}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-secondary {position:absolute;right:0;bottom:4px;width:60%;padding:6px;border:1px solid var(--line);background:var(--surface);color:var(--ink);transform:rotate(2deg);box-shadow:0 12px 28px rgb(0 0 0 / .16);z-index:1;text-align:left}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-secondary img {display:block;width:100%;height:auto;object-fit:contain;filter:none}
  .secondary-stage {position:static}
  .screenshot-secondary > span {display:flex;justify-content:space-between;gap:8px;padding:8px 3px 3px;font:10px/1.4 monospace}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-secondary[data-portrait="true"] {width:27%;max-width:170px;border:5px solid var(--ink);border-radius:20px;padding:2px;transform:rotate(3deg)}
  .screenshot-secondary[data-portrait="true"] img {border-radius:12px}
  :global(#kim-portfolio) .screenshot-gallery[data-composition="review"] .screenshot-window {transform:rotate(.5deg)}
  :global(#kim-portfolio) .screenshot-gallery[data-composition="review"] .screenshot-secondary {transform:rotate(-2deg)}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-toolbar {padding:20px 0 0;min-height:116px;display:flex;flex-direction:column;align-items:flex-start;gap:12px}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-thumbnails {display:flex;flex-wrap:wrap;gap:8px}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-thumbnail {width:76px;height:54px;min-width:0;min-height:44px}
  :global(#kim-portfolio) .screenshot-gallery .screenshot-thumbnail img {object-fit:contain}
  :global(#kim-portfolio) .screenshot-gallery .viewer-toolbar {display:flex;flex-direction:column;gap:12px}
  .viewer-selectors {display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
  @container(max-width:700px) {
    :global(#kim-portfolio) .screenshot-gallery .screenshot-composition {padding:0;display:flex;flex-direction:column;gap:18px}
    :global(#kim-portfolio) .screenshot-gallery .screenshot-window {width:100%;transform:none}
    .secondary-stage {position:relative;height:330px}
    :global(#kim-portfolio) .screenshot-gallery .screenshot-secondary {position:absolute;inset:0 0 auto auto;width:65%;transform:none}
    :global(#kim-portfolio) .screenshot-gallery .screenshot-secondary[data-portrait="true"] {width:34%;max-width:124px;transform:none}
  }
</style>
