---
import ScreenshotCarousel from './ScreenshotCarousel.astro';
import { projects } from '../data/portfolio';
---
<section class="ke-work work-scroll scroll-scene" data-scroll-scene="work" id="ke-work" aria-labelledby="work-heading">
  <div class="scene-stage work-stage">
  <div class="ke-sectionline"><span class="ke-mono">03 / SELECTED WORK</span><span class="ke-mono">A FEW THINGS I’VE BUILT</span></div>
  <h2 id="work-heading" class="sr-only">Selected projects</h2>
  <div class="project-carousel" role="region" aria-roledescription="carousel" aria-label="Selected projects" tabindex="0">
    <div class="project-orbit" aria-label="Project overview">
      <div class="orbit-title"><span class="ke-mono">SELECTED</span><strong>WORK<span>’26</span></strong><span class="ke-mono">CHOOSE A PROJECT ↗</span></div>
      <div class="project-selectors" role="group" aria-label="Choose a project">
        {projects.map((project, i) => <button type="button" data-project-select={i} data-project-name={project.name} aria-pressed="false" aria-controls={`project-slide-${i}`} style={`--angle:${i * 360/projects.length - 90}deg;--counter-angle:${90-i*360/projects.length}deg`}>
          {project.images[0]?.src && <img src={project.images[0].src} alt="" loading="lazy" width="260" height="160"/>}
          <span><small>0{i+1}</small>{project.name}<span aria-hidden="true">↗</span></span>
        </button>)}
      </div>
    </div>
    <p class="work-scroll-caption"><span class="ke-mono">SCROLL TO EXPLORE ↓</span><span data-work-caption>Click any project to open full screen ↗</span></p>
    <dialog class="project-fullscreen" aria-label="Project details" tabindex="-1">
    <button type="button" class="orbit-back" hidden>Close project ×</button>
    <div class="project-viewport">
      <div class="project-track">
        {projects.map((project, i) => (
          <article class="project-slide" id={`project-slide-${i}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${projects.length}: ${project.name}`} data-peek={i === 1 ? "true" : undefined} aria-hidden={i !== 0 ? 'true' : undefined} inert={i !== 0}>
        <div class="project-copy">
          <span class="ke-number">{String(i + 1).padStart(2, '0')}</span><h3>{project.name}</h3><p class="project-headline">{project.headline}</p><p class="project-description">{project.description}</p><span class="ke-mono">{project.stack}</span>
          {project.contribution && <details class="ke-details"><summary>My contribution <span class="action-arrow" aria-hidden="true">&#8599;</span></summary><p>{project.contribution}</p></details>}
          <div class="project-links">
            {project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noopener noreferrer">Visit website <span class="action-arrow" aria-hidden="true">&#8599;</span></a>}
            {project.codeUrl && <a href={project.codeUrl} target="_blank" rel="noopener noreferrer">View source <span class="action-arrow" aria-hidden="true">&#8599;</span></a>}
          </div>
        </div>
            <div class="project-visual"><ScreenshotCarousel images={project.images} name={project.name} composition={project.composition} /></div>
          </article>
        ))}
      </div>
    </div>
    <div class="project-navigation">
      <button type="button" data-project-step="-1" disabled={projects.length < 2}><span class="action-inner">Previous project</span></button>
      <span class="project-counter" aria-live="polite" aria-atomic="true">PROJECT {projects.length ? '01' : '00'} / {String(projects.length).padStart(2, '0')}</span>
      <button type="button" data-project-step="1" disabled={projects.length < 2}><span class="action-inner">Next project</span></button>
    </div>
    </dialog>
  </div>
  </div>
</section>
<script>import '../scripts/project-carousel.js';</script>

<style>
  :global(#kim-portfolio) .ke-work .project-slide {grid-template-columns:minmax(0,.9fr) minmax(0,1.25fr);padding:clamp(20px,3.5cqw,48px);gap:clamp(24px,4cqw,56px);align-items:center}
  :global(#kim-portfolio) .ke-work .project-copy h3 {font-size:clamp(27px,3.1cqw,43px);letter-spacing:-.04em;margin:0 0 22px;line-height:1.1}
  :global(#kim-portfolio) .ke-work .project-copy .project-headline {font:italic clamp(28px,3.6cqw,49px)/1.08 Georgia,serif;letter-spacing:-.035em;margin:0 0 22px;color:var(--ink);max-width:15ch}
  :global(#kim-portfolio) .ke-work .project-description {font-size:14px;line-height:1.75;color:var(--muted);margin:0 0 20px}
  :global(#kim-portfolio) .ke-work .project-copy .ke-mono {display:block;font-size:11px;line-height:1.7}
  :global(#kim-portfolio) .ke-work .project-links {margin-top:12px;display:flex;flex-wrap:wrap;gap:12px 24px}
  @container(max-width:900px) {
    :global(#kim-portfolio) .ke-work .project-slide {grid-template-columns:1fr;align-items:start}
    :global(#kim-portfolio) .ke-work .project-copy .project-headline {max-width:24ch;font-size:clamp(30px,5.5cqw,44px)}
  }
</style>

<style>
  .project-orbit {position:relative;min-height:660px;height:min(78svh,720px);margin:20px 0}
  .orbit-title {position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;pointer-events:none}
  .orbit-title > .ke-mono:last-child {position:absolute;bottom:8px}
  .orbit-title strong {font:700 clamp(36px,5cqw,64px)/.9 Arial,sans-serif;letter-spacing:-.06em;text-align:center}
  .orbit-title strong span {display:block;font:italic 44px/1 Georgia,serif}
  :global(#kim-portfolio) .project-orbit .project-selectors {position:absolute;inset:0;display:block;margin:0;border:1px solid var(--line);border-radius:50%;width:480px;height:480px;max-width:80%;left:50%;top:50%;translate:-50% -50%}
  :global(#kim-portfolio) .project-orbit .project-selectors button {position:absolute;top:50%;left:50%;width:clamp(150px,20cqw,230px);padding:8px;background:var(--paper);color:var(--ink);border:1px solid var(--line);transform:translate(-50%,-50%) rotate(var(--angle)) translateX(240px) rotate(var(--counter-angle)) rotate(-6deg);transition:box-shadow .25s,scale .25s;box-shadow:0 12px 30px #0002}
  :global(#kim-portfolio) .project-orbit .project-selectors button:hover,:global(#kim-portfolio) .project-orbit .project-selectors button:focus-visible {scale:1.04;box-shadow:0 18px 45px #0004;z-index:2}
  .project-selectors img {width:100%;height:clamp(90px,12cqw,135px);object-fit:cover;object-position:top;display:block;filter:grayscale(1)}
  .project-selectors button:hover img {filter:none}
  .project-selectors button>span {display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 4px 4px;font-size:12px}
  .project-selectors small {font:10px monospace;opacity:.5}
  .orbit-back {min-height:44px;background:none;border:0;color:var(--ink);cursor:pointer;margin-bottom:16px}
  .project-carousel[data-overview] .project-viewport,.project-carousel[data-overview] .project-navigation {display:none!important}
  .project-carousel[data-detail] .project-orbit {display:none}
  @container(max-width:700px) {
    .project-orbit {min-height:490px;height:65svh;max-height:560px}
    :global(#kim-portfolio) .project-orbit .project-selectors {width:280px;height:280px}
    :global(#kim-portfolio) .project-orbit .project-selectors button {width:clamp(100px,29cqw,160px);transform:translate(-50%,-50%) rotate(var(--angle)) translateX(clamp(95px,32cqw,135px)) rotate(var(--counter-angle)) rotate(-6deg)}
    .project-selectors button>span {font-size:10px;gap:4px}
    .orbit-title > .ke-mono:last-child {position:absolute;bottom:8px}
  .orbit-title strong {font-size:clamp(20px,6.5cqw,26px)}.orbit-title .ke-mono {font-size:8px}
    .orbit-title {gap:12px}
  }
  @media(prefers-reduced-motion:reduce) { :global(#kim-portfolio) .project-orbit .project-selectors button {transition:none} }
</style>
