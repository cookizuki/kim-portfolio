---
import { profile } from '../data/portfolio';
---
<section class="ke-about" id="ke-about" aria-labelledby="about-heading">
  <figure class="about-portrait"><div class="ke-portrait kim-about-photo"><img src="/images/about-halftone.jpg" alt="Kim Maturan smiling, in black-and-white halftone" width="700" height="758" loading="lazy" /></div><figcaption><span>Behind the work.</span><strong>Kim Maturan</strong></figcaption></figure>
  <div class="about-copy"><span class="ke-mono">01 / THE HUMAN PART</span><h2 id="about-heading">Focus on the goal.<br /><em>Appreciate the journey.</em></h2><p>{profile.bio}</p>
    <ol class="about-roles">
      <li><span class="ke-mono">01</span><div><h3>Building useful things</h3><p>Software development &#183; Founder, KNR Collectives</p></div></li>
      <li><span class="ke-mono">02</span><div><h3>Seeing the details</h3><p>Photography &#183; Graphic design &#183; Video editing</p></div></li>
      <li><span class="ke-mono">03</span><div><h3>Growing with a community</h3><p>Co-Lead &amp; Executive Assistant &#183; AWS SBG</p></div></li>
    </ol>
    {profile.resume && <div class="resume-links">
      <a class="ke-resume" href={profile.resume} target="_blank" rel="noopener noreferrer">View r&#233;sum&#233; <span class="action-arrow" aria-hidden="true">&#8599;</span></a>
      <a class="ke-resume resume-download" href={profile.resume} download>Download PDF <span class="action-arrow" aria-hidden="true">&#8595;</span></a>
    </div>}
  </div>
</section>

<style>
  :global(#kim-portfolio) .ke-about {grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(40px,7cqw,100px);padding-block:clamp(64px,7cqw,100px);align-items:center}
  .about-portrait {position:relative;min-width:0;margin:0;padding:16px 24px 40px 8px}
  :global(#kim-portfolio) .about-portrait .kim-about-photo {min-height:0;margin:0;padding:12px;background:var(--surface);border:1px solid var(--line);transform:rotate(-3deg);box-shadow:0 16px 40px rgb(0 0 0 / .12)}
  :global(#kim-portfolio) .about-portrait img {display:block;width:100%;height:auto;object-fit:contain;filter:none}
  .about-portrait figcaption {position:absolute;right:0;bottom:12px;max-width:80%;padding:16px 22px;background:var(--paper);color:var(--ink);border:1px solid var(--line);box-shadow:0 6px 18px rgb(0 0 0 / .06);transform:rotate(2deg)}
  .about-portrait figcaption span {display:block;font:italic 22px/1.25 Georgia,serif}
  .about-portrait figcaption strong {display:block;margin-top:8px;font:11px/1.5 monospace;letter-spacing:.06em}
  .about-copy {min-width:0}
  :global(#kim-portfolio) .about-copy h2 {font-size:clamp(32px,4.3cqw,60px);line-height:1.06;letter-spacing:-.04em;margin:24px 0}
  .about-copy > p {line-height:1.8;color:var(--muted);max-width:58ch}
  .about-roles {list-style:none;margin:28px 0 20px;padding:0}
  .about-roles li {display:grid;grid-template-columns:26px minmax(0,1fr);gap:14px;border-top:1px solid var(--line);padding:15px 0}
  .about-roles li:last-child {border-bottom:1px solid var(--line)}
  .about-roles .ke-mono {padding-top:3px;color:var(--muted)}
  :global(#kim-portfolio) .about-roles h3 {font-size:15px;font-weight:500;line-height:1.4;margin:0 0 4px}
  :global(#kim-portfolio) .about-roles p {font-size:12px;line-height:1.6;margin:0;color:var(--muted)}
  :global(#kim-portfolio) .resume-links {display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;margin-top:12px}
  :global(#kim-portfolio) .resume-links .ke-resume {display:inline-flex;align-items:center;gap:6px;min-height:44px;margin-top:0;font-size:13px}
  :global(#kim-portfolio) .resume-links .resume-download {color:var(--muted);font-size:12px}
  @container(max-width:800px) {
    :global(#kim-portfolio) .ke-about {grid-template-columns:1fr;gap:32px}
    .about-portrait {width:min(100%,420px);justify-self:center;padding:10px 20px 38px 10px}
    :global(#kim-portfolio) .about-portrait .kim-about-photo {transform:rotate(-1.5deg)}
    :global(#kim-portfolio) .about-copy h2 {font-size:clamp(32px,7cqw,50px)}
  }
</style>
