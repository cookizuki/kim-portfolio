---
import { profile } from '../data/portfolio';
---
<section class="ke-about about-scroll scroll-scene" id="ke-about" aria-labelledby="about-heading" data-scroll-scene="about">
  <div class="scene-stage about-stage">
    <img class="about-background" src="/images/about-background.jpg" alt="" width="728" height="455" loading="lazy" aria-hidden="true" />
    <div class="about-title"><span class="ke-mono">01 / THE HUMAN PART</span><h2 id="about-heading">ABOUT <em>ME.</em></h2><span class="scene-hint">SCROLL TO MEET THE PERSON ↓</span></div>
    <div class="about-reveal">
      <figure class="about-restored-portrait"><img src="/images/about-halftone.jpg" alt="Kim Maturan smiling, in black-and-white halftone" width="700" height="758" loading="lazy"/><figcaption>Behind the work. <strong>Kim Maturan</strong></figcaption></figure>
      <div class="about-reveal-copy"><span class="ke-mono">KIM MATURAN / THE HUMAN PART</span><h3>Focus on the goal.<br/><em>Appreciate the journey.</em></h3><p>{profile.bio}</p>
        <div class="about-interests"><span>Software development</span><span>Photography · Design · Video</span><span>Community &amp; leadership</span></div>
        {profile.resume && <div class="resume-links"><a class="ke-resume" href={profile.resume} target="_blank" rel="noopener noreferrer">View résumé ↗</a><a class="ke-resume" href={profile.resume} download>Download PDF ↓</a></div>}
      </div>
    </div>
  </div>
</section>
